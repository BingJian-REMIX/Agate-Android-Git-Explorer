<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agate.SettingsPage"
             Title="设置"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="20">

            <!-- Token 管理 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Token 管理" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="支持 GitHub、GitLab、Gitee、Bitbucket、CNB、Gitea 等平台，可同时保存多个账号；推送时按远端主机自动匹配。Token 存在系统安全存储里。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                <Label x:Name="TokenCountLabel" Text=""
                       FontSize="12" TextColor="{AppThemeBinding Light=#5F6779, Dark=#8B94A8}" />
                <Button Text="管理 Token" Clicked="OnManageTokensClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

            <!-- 主题 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="主题" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Picker x:Name="ThemePicker" SelectedIndexChanged="OnThemeChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>跟随系统</x:String>
                            <x:String>浅色</x:String>
                            <x:String>深色</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <!-- 服务器端口 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Web 服务器端口" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1"
                        Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="PortEntry"
                           Keyboard="Numeric"
                           Placeholder="8080"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent"
                           HeightRequest="46" />
                </Border>
                <Button Text="保存端口" Clicked="OnSavePortClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

            <!-- 提交与推送 -->
            <VerticalStackLayout Spacing="10">
                <Label Text="提交与推送" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="控制点「提交」之后的行为。远端有新提交导致被拒时，把「推送前先拉取」改成 rebase 通常就能直接推上去。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="提交后自动推送" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                    <Switch x:Name="AutoPushSwitch" Grid.Column="1" Toggled="OnAutoPushToggled" />
                </Grid>

                <Label Text="推送前先拉取" FontSize="12"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Picker x:Name="PullPicker" SelectedIndexChanged="OnPullStrategyChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>不拉取，直接推</x:String>
                            <x:String>先 rebase 再推</x:String>
                            <x:String>先 merge 再推</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="强制推送" FontSize="12"
                               TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                        <Label Text="会用本地历史覆盖远端同名分支，仅在确定远端没有别人的提交时打开。"
                               FontSize="10" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                    </VerticalStackLayout>
                    <Switch x:Name="ForcePushSwitch" Grid.Column="1" VerticalOptions="Center" Toggled="OnForcePushToggled" />
                </Grid>
            </VerticalStackLayout>

            <!-- Shizuku（受限目录访问） -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Shizuku 权限" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="Android/data 与 Android/obb 从 Android 11 起禁止第三方应用访问。装上 Shizuku 并授权后，Agate 可以借它的 shell 身份读写这两个目录。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                <Label x:Name="ShizukuStatusLabel" Text="正在检测…"
                       FontSize="12" TextColor="{AppThemeBinding Light=#5F6779, Dark=#8B94A8}" />
                <Button Text="刷新状态" Clicked="OnRefreshShizukuClicked" Style="{StaticResource CtxButton}" />
                <Button Text="授权 / 安装 Shizuku" Clicked="OnRequestShizukuClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

            <!-- 网络存储 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="网络存储" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="添加 WebDAV / SMB 远程存储，在「浏览位置」里直接挂载访问、上传下载。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                <Button Text="管理网络存储" Clicked="OnNetworkStorageClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

            <!-- 清理回收站 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="清理回收站" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="删除本应用在沙盒回收站里的文件，释放空间。此操作不可撤销。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                <Button Text="清理回收站" Clicked="OnClearTrashClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
