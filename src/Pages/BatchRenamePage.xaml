<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pebble.BatchRenamePage"
             Title="批量重命名"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <Grid RowDefinitions="Auto,*,Auto">
        <ScrollView Grid.Row="0" MaximumHeightRequest="360">
            <VerticalStackLayout Padding="16,12,16,8" Spacing="14">

                <VerticalStackLayout Spacing="8">
                    <Label Text="重命名方式" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                    <Picker x:Name="ModePicker" SelectedIndex="0" SelectedIndexChanged="OnModeChanged"
                            TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>按序号模板</x:String>
                                <x:String>正则替换</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- 序号模式 -->
                <VerticalStackLayout x:Name="SequenceSection" Spacing="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="模板" FontSize="12"
                               TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                                Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="TemplateEntry" TextChanged="OnInputChanged"
                                   PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                                   TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                                   BackgroundColor="Transparent" HeightRequest="46" />
                        </Border>
                        <Label Text="{}{name}=原名  {ext}=扩展名  {n}=序号  {n:000}=补零"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="起始序号" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                                    Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Entry x:Name="StartEntry" Text="1" Keyboard="Numeric" TextChanged="OnInputChanged"
                                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                                       BackgroundColor="Transparent" HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" WidthRequest="110">
                            <Label Text="步长" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                                    Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Entry x:Name="StepEntry" Text="1" Keyboard="Numeric" TextChanged="OnInputChanged"
                                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                                       BackgroundColor="Transparent" HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- 正则模式 -->
                <VerticalStackLayout x:Name="RegexSection" IsVisible="False" Spacing="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="查找（正则）" FontSize="12"
                               TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                                Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="PatternEntry" Placeholder="如 (\d{4})-(\d{2})" TextChanged="OnInputChanged"
                                   PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                                   TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                                   BackgroundColor="Transparent" HeightRequest="46" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="替换为" FontSize="12"
                               TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                                Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="ReplacementEntry" Placeholder="如 $2_$1" TextChanged="OnInputChanged"
                                   PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                                   TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                                   BackgroundColor="Transparent" HeightRequest="46" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="包含扩展名" FontSize="13" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                        <Switch x:Name="IncludeExtSwitch" Grid.Column="1" Toggled="OnInputChanged" />
                    </Grid>
                </VerticalStackLayout>

                <Label x:Name="SummaryLabel" FontSize="12"
                       TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- 预览列表：原名 → 新名，冲突项标红 -->
        <CollectionView Grid.Row="1" x:Name="PreviewList" SelectionMode="None" Margin="8,0,8,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="14,8" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <Label Text="{Binding Original}" FontSize="12" LineBreakMode="MiddleTruncation"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#5A6172, Dark=#8B93A7}" />
                        <Label Grid.Column="1" Text="→" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                        <Label Grid.Column="2" Text="{Binding Target}" FontSize="12" LineBreakMode="MiddleTruncation"
                               VerticalOptions="Center"
                               TextColor="{Binding TargetColor}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,20" Spacing="8">
            <Label x:Name="StatusLabel" FontSize="12" IsVisible="False"
                   TextColor="{AppThemeBinding Light=#C0392B, Dark=#FF7A6B}" />
            <Button x:Name="ApplyButton" Text="执行重命名" Clicked="OnApplyClicked"
                    Style="{StaticResource CtxButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
