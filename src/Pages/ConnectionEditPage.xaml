<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agate.ConnectionEditPage"
             Title="连接设置"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="18">

            <VerticalStackLayout Spacing="8">
                <Label Text="名称" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry x:Name="NameEntry" Placeholder="如：我家 NAS"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent" HeightRequest="46" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="类型" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Picker x:Name="TypePicker">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>WebDAV</x:String>
                            <x:String>SMB</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                <Label x:Name="TypeHint" Text="WebDAV 已完整支持；SMB 暂未实现，敬请期待。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="服务器地址" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry x:Name="UrlEntry" Keyboard="Url"
                           Placeholder="https://nas.example.com/dav/"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent" HeightRequest="46" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="账号" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry x:Name="UserEntry" Placeholder="匿名可留空"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent" HeightRequest="46" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="密码" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry x:Name="PassEntry" IsPassword="True"
                           Placeholder="留空表示无密码"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent" HeightRequest="46" />
                </Border>
            </VerticalStackLayout>

            <Button Text="测试连接" Clicked="OnTestClicked" Style="{StaticResource CtxButton}" />
            <Button Text="保存" Clicked="OnSaveClicked" Style="{StaticResource CtxButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
