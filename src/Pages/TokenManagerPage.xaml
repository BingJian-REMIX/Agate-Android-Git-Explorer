<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agate.TokenManagerPage"
             Title="Token 管理"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

            <Label Text="为各个代码托管平台保存访问令牌。推送时按仓库的远端主机名自动匹配，不用每次手动填。"
                   FontSize="11" LineHeight="1.5"
                   TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />

            <!-- 已保存的凭据 -->
            <VerticalStackLayout x:Name="CredentialList" Spacing="8" />

            <Border x:Name="EmptyHint"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                    Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="还没有保存任何 Token。私有仓库的推送需要它。"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#5F6779, Dark=#8B94A8}" />
            </Border>

            <Button Text="添加 Token" Clicked="OnAddClicked" Style="{StaticResource CtxButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
