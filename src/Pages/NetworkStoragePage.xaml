<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agate.NetworkStoragePage"
             Title="网络存储"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="ConnList"
                        Grid.Row="0"
                        SelectionMode="None"
                        ItemsSource="{Binding Conns}"
                        BackgroundColor="Transparent"
                        Margin="12,8,12,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,60,0,0">
                    <Label Text="还没有网络存储"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1F2430, Dark=#E6E9F2}" />
                    <Label Text="点击底部「添加连接」配置 WebDAV 服务器。"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="14,12" ColumnDefinitions="36,*,Auto" RowDefinitions="Auto,Auto">
                        <Image Grid.Column="0" Grid.RowSpan="2"
                               Source="{AppThemeBinding Light=folder_light, Dark=folder}"
                               WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="0"
                               Text="{Binding Name}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F2430, Dark=#E6E9F2}" />
                        <Label Grid.Column="1" Grid.Row="1"
                               Text="{Binding Url}"
                               FontSize="11"
                               LineBreakMode="MiddleTruncation"
                               TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                        <Label Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                               Text="{Binding Type}"
                               FontSize="11"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#7C5CFF, Dark=#9B86FF}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConnTapped"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="＋ 添加连接"
                Margin="16,12,16,16"
                Style="{StaticResource CtxButton}"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
